    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "6.0.3",
    "googleapis": "^161.0.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "multer": "^2.0.2",
    "nodemon": "^3.1.10",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "prisma": "^6.16.3"
